{
  "priority": 1,
  "request": {
    "method": "GET",
    "urlPath": "/v1/rates",
    "queryParameters": {
      "base": { "equalTo": "USD" },
      "quote": { "equalTo": "BRL" }
    }
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": { "baseCurrency": "USD", "quoteCurrency": "BRL", "rate": "invalid" }
  }
}
